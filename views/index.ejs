<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Firewall blocklist 
    </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Firewall blocklist</h1>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Priority</th>
                <th>MAC address</th>
            </tr>
        </thead>
        <tbody>
            <% rules.forEach(rule => { %>
                <% if (rule.enabled == 0) { %>
                    <tr style="font-style: italic;">
                        <td><%= rule.id %></td>
                        <td><%= rule.priority %></td>
                        <td><%= rule.mac %></td>
                    </tr>
                <% } else { %>
                    <tr>
                        <td><%= rule.id %></td>
                        <td><%= rule.priority %></td>
                        <td><%= rule.mac %></td>
                    </tr>
                <% } %>
            <% }) %>
        </tbody>
    </table>

    <h2>Add new rule</h2>
    <form method="post">
        <label for="priority">Priority</label>
        <input type="number" name="priority"> <br>
        <label for="mac">MAC address (use correct format)</label>
        <input type="text" name="mac"> <br>
        <label for="enabled">Enabled</label>
        <input type="radio" name="enabled" value="1" checked> 
        <label for="enabled">Disabled</label>
        <input type="radio" name="enabled" value="0"> <br>
        <button type="submit">Create new rule</button>
    </form>

    <p>
        <% if (locals.errors) { %>
            <% locals.errors.forEach(error => { %>
                <%= error %> <br>
            <% }) %>
        <% } %>
        <% if (locals.success) { %>
            <%= locals.success %>
        <% } %>
    </p>
</body>
</html>